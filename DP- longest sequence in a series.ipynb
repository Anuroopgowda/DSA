   "source": [
    "# longest sequence in a series\n",
    "nums = [0,1,0,3,2,3]\n",
    "dp=[1]*len(nums)\n",
    "for i in range(len(nums)-1,-1,-1):\n",
    "    for j in range(i+1,len(nums)):\n",
    "        if nums[j]>nums[i]:\n",
    "            num=1+dp[j]\n",
    "            if num>dp[i]:\n",
    "                dp[i]=num\n",
    "print(dp)"
   ]
  },
