   "source": [
    "#maximum subarray\n",
    "#method \n",
    "nums=[-2,1,-3,4,-1,2,1,-5,4]\n",
    "maxsum=nums[0]\n",
    "cursum=0\n",
    "for n in nums:\n",
    "    if cursum<0:\n",
    "        cursum=0\n",
    "    cursum+=n\n",
    "    maxsum=max(maxsum,cursum)\n",
    "print(maxsum)\n",
    "    "
   ]
